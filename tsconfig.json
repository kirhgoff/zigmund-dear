{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "docs"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "xlib/*": ["./xlib/*"] }
  }
}
