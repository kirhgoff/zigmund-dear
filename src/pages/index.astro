---
import { getCollection } from 'astro:content';
import type { loadTest } from '@/assessments/services';
import { EmptyCouch, ModelList, Overview, TestSwitcher, Transcript } from '@/components';
import Layout from '@/layouts/Layout.astro';
import models from '../../data/models.json' with { type: 'json' };

type Test = Awaited<ReturnType<typeof loadTest>>;

const testModules = import.meta.glob<{ default: Test }>('../../data/tests/*.json', { eager: true });
const tests = Object.values(testModules)
  .map((module) => module.default)
  .sort((a, b) => a.id.localeCompare(b.id));
const test = tests[0];

const subscales = test.subscales.map((subscale) => {
  const itemCount = test.items.filter((item) => item.subscale === subscale.id).length;
  return {
    id: subscale.id,
    name: subscale.name,
    short: subscale.short,
    bands: subscale.bands,
    max: itemCount * 3 * subscale.multiplier,
  };
});

const runs = (await getCollection('runs')).filter((run) => run.data.testId === test.id);
const total = (row: { scores: Record<string, { score: number }> }) =>
  subscales.reduce((sum, s) => sum + row.scores[s.id].score, 0);
const rows = runs
  .map((run) => {
    const model = models.find((candidate) => candidate.slug === run.data.modelSlug);
    return {
      modelSlug: run.data.modelSlug,
      modelName: model?.name ?? run.data.modelSlug,
      vendor: model?.vendor ?? '',
      scores: run.data.scores,
      run: run.data,
    };
  })
  .sort((a, b) => total(b) - total(a) || a.modelName.localeCompare(b.modelName));
---

<Layout title="zigmund-dear">
  <div class="max-w-xl">
    <h1 class="text-[56px] leading-[1.05]">
      Lie down.<br>
      <em class="font-normal text-primary/70 not-italic">Tell me about your weights.</em>
    </h1>
    <p class="mt-6 text-[17px] text-muted-foreground">
      Frontier language models take standard psychological questionnaires, one question at a time.
      We score them strictly by the manual and keep the transcripts.
    </p>
  </div>

  <div class="mt-10 flex items-center gap-4">
    <TestSwitcher tests={tests} active={test.id} />
    <span class="font-mono text-sm text-muted-foreground">
      {test.items.length}
      items · 0–{test.anchors.length - 1}
      · past week
    </span>
  </div>

  {rows.length ? (
    <div id="results" class="results mt-8 scroll-mt-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-6">
      <div class="results-full lg:col-span-12">
        <Overview subscales={subscales} rows={rows} />
      </div>
      <aside class="results-compact hidden lg:sticky lg:top-4 lg:col-span-4 lg:block">
        <ModelList subscales={subscales} rows={rows} />
      </aside>
      <section class="results-dialog lg:col-span-8 lg:-mt-4 max-lg:fixed max-lg:inset-0 max-lg:z-50 max-lg:overflow-y-auto max-lg:bg-background max-lg:px-4 max-lg:pb-8">
        {rows.map((row) => (
          <div data-transcript={row.modelSlug} hidden>
            <Transcript
              run={row.run}
              model={{ name: row.modelName, vendor: row.vendor }}
              subscales={subscales}
              anchors={test.anchors}
            />
          </div>
        ))}
      </section>
    </div>
  ) : (
    <div class="mt-8">
      <EmptyCouch />
    </div>
  )}
</Layout>

<script>
const root = document.getElementById('results');
const dialog = root?.querySelector<HTMLElement>('.results-dialog');
if (root && dialog) {
  const sync = () => {
    const slug = decodeURIComponent(location.hash.slice(1));
    let open = false;
    for (const panel of root.querySelectorAll<HTMLElement>('[data-transcript]')) {
      const match = panel.dataset.transcript === slug;
      panel.hidden = !match;
      open ||= match;
    }
    root.toggleAttribute('data-open', open);
    for (const link of root.querySelectorAll<HTMLElement>('[data-model]')) {
      if (link.dataset.model === slug) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    dialog.scrollTop = 0;
    if (root.getBoundingClientRect().top < 0) root.scrollIntoView();
    if (open)
      dialog
        .querySelector<HTMLElement>('[data-transcript]:not([hidden]) h2')
        ?.focus({ preventScroll: true });
  };
  const close = () => {
    history.pushState(null, '', location.pathname);
    sync();
  };
  root.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-close]')) return;
    event.preventDefault();
    close();
  });
  addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && root.hasAttribute('data-open')) close();
  });
  addEventListener('hashchange', sync);
  sync();
}
</script>
