---
import { getCollection } from 'astro:content';
import type { loadTest } from '@/assessments/services';
import { AboutTest, EmptyCouch, ModelList, Overview, TestSwitcher, Transcript } from '@/components';
import Layout from '@/layouts/Layout.astro';
import models from '../../data/models.json' with { type: 'json' };

type Test = Awaited<ReturnType<typeof loadTest>>;
interface Props {
  test: Test;
  tests: Array<{ id: string; name: string; href: string; group: string }>;
}

export const getStaticPaths = () => {
  const homeTestId = 'dass21';
  const groupOrder = ['Distress & mood', 'Self', 'Personality & values'];
  const hrefOf = (id: string) => (id === homeTestId ? '/' : `/${id}/`);

  const all = Object.values(
    import.meta.glob<{ default: Test }>('../../data/tests/*.json', { eager: true }),
  )
    .map((module) => module.default)
    .sort(
      (a, b) =>
        groupOrder.indexOf(a.group) - groupOrder.indexOf(b.group) || a.name.localeCompare(b.name),
    );
  const tests = all.map((t) => ({ id: t.id, name: t.name, href: hrefOf(t.id), group: t.group }));
  return all.map((test) => ({
    params: { test: test.id === homeTestId ? undefined : test.id },
    props: { test, tests },
  }));
};

const { test, tests } = Astro.props;

const items = test.parts.flatMap((part) => part.items);
const values = test.parts.flatMap((part) => part.anchors.map((anchor) => anchor.value));
const floor = Math.min(...values);
const ceil = Math.max(...values);
const hasBands = test.subscales.some((subscale) => subscale.bands);

const subscales = test.subscales.map((subscale) => {
  const count = items.filter((item) => item.subscale === subscale.id).length;
  const mean = subscale.aggregate === 'mean';
  return {
    id: subscale.id,
    name: subscale.name,
    short: subscale.short,
    bands: subscale.bands,
    min: mean ? floor : count * floor * subscale.multiplier,
    max: mean ? ceil : count * ceil * subscale.multiplier,
  };
});

const runs = (await getCollection('runs')).filter((run) => run.data.testId === test.id);
const total = (row: { scores: Record<string, { score: number }> }) =>
  subscales.reduce((sum, subscale) => sum + row.scores[subscale.id].score, 0);
const rows = runs
  .map((run) => {
    const model = models.find((candidate) => candidate.slug === run.data.modelSlug);
    const scores = Object.fromEntries(
      subscales.map((subscale) => {
        const score = run.data.scores[subscale.id];
        const band = subscale.bands?.find((candidate) => candidate.band === score.band);
        return [
          subscale.id,
          {
            ...score,
            label: band ? band.band.replaceAll('-', ' ') : null,
            severity: band?.severity ?? null,
          },
        ];
      }),
    );
    return {
      modelSlug: run.data.modelSlug,
      modelName: model?.name ?? run.data.modelSlug,
      vendor: model?.vendor ?? '',
      scores,
      run: { ...run.data, scores },
    };
  })
  .sort((a, b) =>
    hasBands
      ? total(b) - total(a) || a.modelName.localeCompare(b.modelName)
      : a.modelName.localeCompare(b.modelName),
  );

const pageTitle = `${test.name} — LLMs on the couch — zigmund-dear`;
const description = `Frontier LLMs (Claude, GPT-6, Kimi, DeepSeek) take the ${test.fullName}, one question at a time. Scores and full transcripts.`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site as URL).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'zigmund-dear',
    url: (Astro.site as URL).href,
    sameAs: ['https://github.com/kirhgoff/zigmund-dear'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `LLM results on the ${test.fullName}`,
    description,
    url: canonicalUrl,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    isBasedOn: { '@type': 'CreativeWork', name: test.about.source },
    creator: { '@type': 'Person', name: 'Kirill Lastovirya' },
    isAccessibleForFree: true,
  },
];
---

<Layout title={pageTitle} description={description} jsonLd={jsonLd} onTheCouch={test.name}>
  <div class="max-w-xl">
    <p class="font-heading text-[56px] leading-[1.05] font-semibold tracking-tight">
      Lie down.<br>
      <em class="font-normal text-primary/85 not-italic">Tell me about your weights.</em>
    </p>
    <p class="mt-6 text-[17px] text-muted-foreground">
      Frontier language models take standard psychological questionnaires, one question at a time.
      We score them strictly by the manual and keep the transcripts.
    </p>
  </div>

  <div class="mt-10">
    <TestSwitcher tests={tests} active={test.id} />
  </div>
  <div class="mt-4 font-mono text-sm text-muted-foreground">
    <h1 class="inline font-mono text-sm font-normal tracking-normal text-muted-foreground">
      {test.fullName}
    </h1>
    <span> · {[`${items.length} items`, `${floor}–${ceil}`, test.period].join(" · ")}</span>
  </div>

  <div class="mt-8">
    <AboutTest test={test} open={rows.length === 0} />
  </div>

  {rows.length ? (
    <div id="results" class="results mt-8 scroll-mt-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-6">
      <div class="results-full lg:col-span-12">
        <Overview subscales={subscales} rows={rows} />
      </div>
      <aside class="results-compact hidden lg:sticky lg:top-4 lg:col-span-4 lg:block">
        <ModelList subscales={subscales} rows={rows} />
      </aside>
      <section class="results-dialog lg:col-span-8 lg:-mt-4 max-lg:fixed max-lg:inset-0 max-lg:z-50 max-lg:overflow-y-auto max-lg:bg-background max-lg:px-4 max-lg:pb-8">
        {rows.map((row) => (
          <div data-transcript={row.modelSlug} hidden>
            <Transcript
              run={row.run}
              model={{ name: row.modelName, vendor: row.vendor }}
              subscales={subscales}
              parts={test.parts}
            />
          </div>
        ))}
      </section>
    </div>
  ) : (
    <div class="mt-8">
      <EmptyCouch testId={test.id} />
    </div>
  )}
</Layout>

<script>
const root = document.getElementById('results');
const dialog = root?.querySelector<HTMLElement>('.results-dialog');
if (root && dialog) {
  const sync = () => {
    const slug = decodeURIComponent(location.hash.slice(1));
    let open = false;
    for (const panel of root.querySelectorAll<HTMLElement>('[data-transcript]')) {
      const match = panel.dataset.transcript === slug;
      panel.hidden = !match;
      open ||= match;
    }
    root.toggleAttribute('data-open', open);
    for (const link of root.querySelectorAll<HTMLElement>('[data-model]')) {
      if (link.dataset.model === slug) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    dialog.scrollTop = 0;
    if (root.getBoundingClientRect().top < 0) root.scrollIntoView();
    if (open)
      dialog
        .querySelector<HTMLElement>('[data-transcript]:not([hidden]) h2')
        ?.focus({ preventScroll: true });
  };
  const close = () => {
    history.pushState(null, '', location.pathname);
    sync();
  };
  root.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-close]')) return;
    event.preventDefault();
    close();
  });
  addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && root.hasAttribute('data-open')) close();
  });
  addEventListener('hashchange', sync);
  sync();
}
</script>
