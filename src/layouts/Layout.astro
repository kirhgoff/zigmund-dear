---
import '@/styles/global.css';
import { Footer } from '@/components';

interface Props {
  title: string;
  onTheCouch?: string;
}

const { title, onTheCouch } = Astro.props;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..600&family=Instrument+Sans:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    >
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{title}</title>
  </head>
  <body>
    <div class="border-b border-border">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <span class="font-heading font-semibold text-[22px]">zigmund-dear</span>
        {onTheCouch && <span class="text-sm text-muted-foreground">on the couch: {onTheCouch}</span>}
      </div>
    </div>
    <main class="mx-auto max-w-5xl px-6 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
