{
  "name": "zigmund-dear",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "take-test": "bun scripts/take-test.ts",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:ui": "eslint src/components",
    "depcruise": "depcruise src xlib scripts --config .dependency-cruiser.js",
